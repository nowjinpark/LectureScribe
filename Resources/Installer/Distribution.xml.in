<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>강의노트 @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="@MINIMUM_OS@"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="lectureScribe"/>
    </choices-outline>
    <choice id="lectureScribe" visible="false" title="강의노트">
        <pkg-ref id="dev.lecturescribe.mac.pkg"/>
    </choice>
    <pkg-ref id="dev.lecturescribe.mac.pkg" version="@VERSION@" onConclusion="none">LectureScribe.pkg</pkg-ref>
</installer-gui-script>
